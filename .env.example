PROJECT_NAME=CheckStock
DEBUG=True

# По умолчанию используется быстрый локальный SQLite (не требует отдельной установки БД)
DATABASE_URL=sqlite+aiosqlite:///./checkstock.db

# Опционально: подключение к внешнему серверу PostgreSQL
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/checkstock
